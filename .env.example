# Dosya Yolu: REPO_ROOT/.env.example
# Amac: Yeni ortam icin gerekli alanlari belgelendirir (gercek sir icermez)
# Modul - Env
# Version: 2.0.1
# Aciklama: Gercek .env, MSSQL.ps1 -Action Start ile uretilir
# Bagimli Oldugu Katman: Config
MSSQL_CONTAINER_NAME=mssql-test
MSSQL_HOSTNAME=mssql-test
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=SET_YOUR_OWN_STRONG_PASSWORD
MSSQL_PID=Developer
MSSQL_VOLUME_NAME=mssql-test-data
